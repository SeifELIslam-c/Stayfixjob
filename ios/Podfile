platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig and running flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# Flutter (stable) automatically adds Firebase plugins via Swift Package Manager
# AND via CocoaPods simultaneously, producing 25 duplicate symbols at link time.
# This hook runs after Flutter injects SPM references but before pod install
# completes, so it strips SPM packages out — leaving CocoaPods as the sole
# Firebase provider and eliminating the conflict.
pre_install do |installer|
  require 'xcodeproj'
  project = Xcodeproj::Project.open(File.expand_path('Runner.xcodeproj', File.dirname(__FILE__)))

  if project.root_object.respond_to?(:package_references)
    project.root_object.package_references.to_a.each(&:remove_from_project)
  end

  project.targets.each do |target|
    if target.respond_to?(:package_product_dependencies)
      target.package_product_dependencies.to_a.each(&:remove_from_project)
    end
  end

  project.save
  puts 'Removed SPM package references — Firebase will be provided by CocoaPods only.'
end

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
