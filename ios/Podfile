platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig and running flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

def strip_spm_from_pbxproj(tag)
  podfile_dir = File.dirname(File.expand_path(__FILE__))
  pbxproj = File.join(podfile_dir, 'Runner.xcodeproj', 'project.pbxproj')

  unless File.exist?(pbxproj)
    puts "#{tag}: project.pbxproj not found — skipping"
    return
  end

  content = File.read(pbxproj)
  before = content.length

  # Flutter uses XCLocalSwiftPackageReference (local pub-cache paths) on newer
  # Xcode, and XCRemoteSwiftPackageReference on older. Cover every variant.
  content.gsub!(/\/\* Begin XC[A-Za-z]*PackageReference section \*\/.*?\/\* End XC[A-Za-z]*PackageReference section \*\//m, '')
  content.gsub!(/\/\* Begin XCSwiftPackageProductDependency section \*\/.*?\/\* End XCSwiftPackageProductDependency section \*\//m, '')

  # Remove reference list keys from PBXProject (remote → packageReferences,
  # local → localPackages) and from PBXNativeTarget (packageProductDependencies).
  content.gsub!(/\n[ \t]+packageReferences = \([^)]*\);/m, '')
  content.gsub!(/\n[ \t]+localPackages = \([^)]*\);/m, '')
  content.gsub!(/\n[ \t]+packageProductDependencies = \([^)]*\);/m, '')

  File.write(pbxproj, content)

  removed = before - content.length
  puts "#{tag}: stripped #{removed} bytes of SPM refs from project.pbxproj"

  # Remove any Package.resolved so Xcode doesn't try to re-resolve SPM deps.
  [
    File.join(podfile_dir, 'Runner.xcodeproj', 'project.xcworkspace', 'xcshareddata', 'swiftpm', 'Package.resolved'),
    File.join(podfile_dir, '..', 'Runner.xcworkspace', 'xcshareddata', 'swiftpm', 'Package.resolved'),
  ].each { |f| File.delete(f) if File.exist?(f) }
end

# Run before pods are installed (covers the normal case where pod install
# runs after Flutter injects SPM into project.pbxproj).
pre_install do |installer|
  strip_spm_from_pbxproj('pre_install')
end

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
  # Second pass — ensures SPM refs are gone even if pre_install ran before
  # Flutter had a chance to inject them (timing varies by Codemagic workflow).
  strip_spm_from_pbxproj('post_install')
end
