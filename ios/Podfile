platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig and running flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# Flutter (stable) automatically adds Firebase plugins via Swift Package Manager
# AND via CocoaPods simultaneously, producing 25 duplicate symbols at link time.
# This hook runs after Flutter injects SPM references but before pod install
# completes. It strips all SPM entries directly from project.pbxproj so only
# CocoaPods provides Firebase — no gem API dependency, fully portable.
pre_install do |installer|
  podfile_dir = File.dirname(File.expand_path(__FILE__))
  pbxproj = File.join(podfile_dir, 'Runner.xcodeproj', 'project.pbxproj')
  pkg_resolved = File.join(podfile_dir, 'Runner.xcodeproj', 'project.xcworkspace',
                           'xcshareddata', 'swiftpm', 'Package.resolved')

  unless File.exist?(pbxproj)
    puts 'pre_install: Runner.xcodeproj/project.pbxproj not found — skipping SPM cleanup'
    next
  end

  content = File.read(pbxproj)
  before_size = content.length

  # Remove the two SPM object sections
  content.gsub!(/\n\/\* Begin XCRemoteSwiftPackageReference section \*\/.*?\/\* End XCRemoteSwiftPackageReference section \*\//m, '')
  content.gsub!(/\n\/\* Begin XCSwiftPackageProductDependency section \*\/.*?\/\* End XCSwiftPackageProductDependency section \*\//m, '')
  # Remove reference lists inside PBXProject / PBXNativeTarget
  content.gsub!(/\n[ \t]+packageReferences = \([^)]*\);/m, '')
  content.gsub!(/\n[ \t]+packageProductDependencies = \([^)]*\);/m, '')

  File.write(pbxproj, content)
  File.delete(pkg_resolved) if File.exist?(pkg_resolved)

  removed = before_size - content.length
  puts "pre_install: Stripped #{removed} bytes of SPM references from project.pbxproj — Firebase via CocoaPods only."
end

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
