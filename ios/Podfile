platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig and running flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

def strip_spm_from_pbxproj(tag)
  require 'fileutils'
  podfile_dir = File.dirname(File.expand_path(__FILE__))
  pbxproj = File.join(podfile_dir, 'Runner.xcodeproj', 'project.pbxproj')

  unless File.exist?(pbxproj)
    puts "#{tag}: project.pbxproj not found — skipping"
    return
  end

  content = File.read(pbxproj)
  before = content.length

  # Flutter ≥3.24 uses XCLocalSwiftPackageReference (local pub-cache paths).
  # Older versions used XCRemoteSwiftPackageReference. Cover every variant.
  content.gsub!(/\/\* Begin XC[A-Za-z]*PackageReference section \*\/.*?\/\* End XC[A-Za-z]*PackageReference section \*\//m, '')
  content.gsub!(/\/\* Begin XCSwiftPackageProductDependency section \*\/.*?\/\* End XCSwiftPackageProductDependency section \*\//m, '')
  # PBXProject reference-list keys differ by package type
  content.gsub!(/\n[\t ]+packageReferences = \([^)]*\);/m, '')
  content.gsub!(/\n[\t ]+localPackages = \([^)]*\);/m, '')
  content.gsub!(/\n[\t ]+packageProductDependencies = \([^)]*\);/m, '')

  File.write(pbxproj, content)
  puts "#{tag}: stripped #{before - content.length} bytes of SPM refs from project.pbxproj"

  # Also remove xcodeproj gem objects if the gem supports local-package API
  begin
    require 'xcodeproj'
    proj = Xcodeproj::Project.open(pbxproj.sub('/project.pbxproj', ''))
    [:package_references, :packages].each do |m|
      next unless proj.root_object.respond_to?(m)
      proj.root_object.send(m).to_a.each(&:remove_from_project)
    end
    proj.targets.each do |t|
      t.package_product_dependencies.to_a.each(&:remove_from_project) if t.respond_to?(:package_product_dependencies)
    end
    proj.save
    puts "#{tag}: xcodeproj gem pass complete"
  rescue => e
    puts "#{tag}: xcodeproj gem pass skipped (#{e.message})"
  end

  # Delete Package.resolved so Xcode cannot re-resolve SPM deps
  [
    File.join(podfile_dir, 'Runner.xcodeproj', 'project.xcworkspace', 'xcshareddata', 'swiftpm', 'Package.resolved'),
    File.join(podfile_dir, '..', 'Runner.xcworkspace', 'xcshareddata', 'swiftpm', 'Package.resolved'),
  ].each { |f| FileUtils.rm_f(f) && puts("#{tag}: deleted #{f}") }
end

pre_install do |installer|
  # If Codemagic runs pod install as a SEPARATE step before flutter build ipa,
  # writing this config here disables SPM for the subsequent build step.
  system('flutter config --no-enable-swift-package-manager > /dev/null 2>&1 || true')
  puts 'pre_install: flutter config --no-enable-swift-package-manager executed'
  strip_spm_from_pbxproj('pre_install')
end

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
  # Second pass — ensures SPM refs are gone even if pre_install ran before
  # Flutter had a chance to inject them (timing varies by Codemagic workflow).
  strip_spm_from_pbxproj('post_install')
end
